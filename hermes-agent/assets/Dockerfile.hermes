# Pin the base image by digest; update only after testing.
FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04@sha256:<paste-base-image-digest>

ENV DEBIAN_FRONTEND=noninteractive

# The agent is only useful if the tools it needs are present. We intentionally install a
# development toolset at build time; runtime installs are blocked by the read-only rootfs.
# Trim or extend this list for your skills and workflows, but keep the hardening flags.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
      curl \
      wget \
      openssh-client \
      unzip \
      zstd \
      tar gzip bzip2 xz-utils \
      jq \
      ripgrep \
      fd-find \
      sqlite3 \
      locales \
      python3 python3-pip python3-venv python-is-python3 \
      nodejs npm \
      build-essential cmake pkg-config \
      libssl-dev libffi-dev \
      libxml2-dev libxslt1-dev zlib1g-dev libjpeg-dev libpng-dev \
      poppler-utils \
      tesseract-ocr \
      pandoc \
      ffmpeg \
      postgresql-client \
      libpq-dev \
      rustc cargo \
 && ln -s $(which fdfind) /usr/local/bin/fd \
 && rm -rf /var/lib/apt/lists/* \
 && (getent group video >/dev/null || groupadd -r video) \
 && useradd -m -u 1000 -s /bin/bash -G video hermes

USER hermes
WORKDIR /home/hermes
ENV HERMES_HOME=/home/hermes/.hermes

# Hermes installer is copied in, not downloaded at build time.
# The version is pinned by the installer script you downloaded on the host
# and by the image tag you set at build time.
COPY --chown=hermes:hermes install-hermes.sh /tmp/install-hermes.sh
RUN bash /tmp/install-hermes.sh && rm /tmp/install-hermes.sh

ENV PATH="/home/hermes/.hermes/bin:${PATH}"
CMD ["sleep", "infinity"]
